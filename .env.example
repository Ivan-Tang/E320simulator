# E320simulator environment configuration
# Copy this file to .env and set values for your environment.

# Path to the Run502 data directory.
# Default (if unset): ~/hep/data_Run502
DATA_PATH=/path/to/your/data_Run502

# ── Cluster Agent (Slack + Email 通知) ──────────────────────────────────────
# 创建 Slack App 后填入（参见 cluster_agent/ 目录的 README）：
#
# 1. 访问 https://api.slack.com/apps → Create New App → From Scratch
# 2. Settings → Socket Mode → Enable → 生成 App-Level Token (xapp-)，Scope: connections:write
# 3. OAuth & Permissions → Bot Token Scopes: chat:write, app_mentions:read, im:history, im:write
#    （若用私有频道还需 groups:history；若用公共频道需 channels:history）
# 4. Install to Workspace → 复制 Bot Token (xoxb-)
# 5. 邀请 bot 到频道: /invite @your-bot-name
# 6. 获取频道 ID: 在频道点右键 → "Copy link"，URL 最后一段即为 ID（C 开头）

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_CHANNEL_ID=C0123456789

# 邮件通知收件人（可选，依赖集群 sendmail）
# NOTIFY_EMAIL=your@email.com

# Claude CLI 超时（秒）：从收到消息到 claude --print 返回的最长等待时间
# 默认 3600（1小时），对于需要改代码+跑测试的任务建议保持默认或更高
# CLAUDE_TIMEOUT=3600

# Claude 默认模型（可选）。留空则由 claude CLI 自行决定。
# 也可在 Slack 中用 !model 动态切换，重启后恢复此值。
# 可选: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
# CLAUDE_MODEL=claude-sonnet-4-6

# Claude 默认 effort（可选）。low/medium/high/max（max 仅限 opus）
# 也可在 Slack 中用 !effort 动态切换
# CLAUDE_EFFORT=medium

# 用户白名单：只有列出的 Slack User ID 才能使用 agent
# 获取方式：Slack → 点击自己头像 → "Copy member ID"（格式 U 开头）
# 留空表示不限制（不推荐，任何 workspace 成员都能操作集群）
# ALLOWED_USER_IDS=U1234567890,UABCDEFGH
